# Device tree
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# File systems
CONFIG_EXFAT_FS=y

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y

# Hardware ID
CONFIG_MI_HARDWARE_ID=m

# IR
CONFIG_IR_SPI=m
CONFIG_LIRC=y
CONFIG_RC_CORE=y
CONFIG_RC_DECODERS=y
CONFIG_RC_DEVICES=y

# Power supply
# CONFIG_BACKLIGHT_QCOM_SPMI_WLED is not set
CONFIG_LEDS_QTI_FLASH=m
CONFIG_QTI_BATTERY_CHARGER=m

# Thermal
CONFIG_MI_THERMAL_INTERFACE=m

# Touchscreen
# CONFIG_TOUCHSCREEN_FTS is not set
# CONFIG_TOUCHSCREEN_NT36XXX is not set
# CONFIG_TOUCHSCREEN_ST is not set

# WiFi
CONFIG_ICNSS2=m
# CONFIG_ICNSS2_RESTART_LEVEL_NOTIF is not set
CONFIG_CNSS2=m
CONFIG_QCA_CLD_WLAN=m

# KernelSU (BakaSU)
# SUSFS is the selected hook mode (SUSFS inline hook); it is mutually
# exclusive with KSU_MANUAL_HOOK inside BakaSU's "Hooking Method" choice.
CONFIG_KSU=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
# CONFIG_KSU_SUSFS_SUS_KSTAT is not set
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
# CONFIG_KSU_TRACEPOINT_HOOK is not set
# CONFIG_KSU_MANUAL_HOOK is not set

# Kernel panic logging: this platform records panics through mtdoops on the
# raw partition /dev/block/sda15 (set up by the vendor_boot cmdline:
# block2mtd.block2mtd=/dev/block/sda15,2097152 mtdoops.mtddev=0).
# LineageOS' defconfig does not enable MTD at all, so panics were lost.
CONFIG_MTD=y
CONFIG_MTD_BLOCK2MTD=y
CONFIG_MTD_OOPS=y
